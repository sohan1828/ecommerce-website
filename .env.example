# ==============================================================================
# Gizmo E-Commerce Application Environment Template (.env.example)
# Duplicate this file as .env and fill in your actual credentials.
# ==============================================================================

# Application Settings
APP_NAME="Gizmo Store"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=your_generated_random_secret_key

# Database Configuration (MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecom
DB_USER=root
DB_PASS=your_mysql_password

# SMTP Mail Authentication Configuration
MAIL_MAILER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@gizmo.com
MAIL_FROM_NAME="Gizmo Store"

# Authentication & Security
SESSION_LIFETIME=86400
CSRF_SECRET=your_csrf_secret_salt
PASSWORD_RESET_TIMEOUT=3600

# Social Authentication (Optional Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/user_login.php

# Admin Contact & Support
ADMIN_EMAIL=admin@gizmo.com
SUPPORT_PHONE="+977 9840000300"
